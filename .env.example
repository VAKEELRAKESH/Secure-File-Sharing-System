# ============================================================
# TrustShare Environment Configuration
# ============================================================
# SETUP (for new systems):
#   1. Copy this file:  cp .env.example .env
#   2. Generate a unique SECRET_KEY (e.g. openssl rand -hex 32)
#   3. Generate a unique MASTER_ENCRYPTION_KEY (64 hex chars / 32 bytes)
#   4. Install backend deps:  cd backend && pip install -r requirements.txt
#   5. Install frontend deps: cd frontend && npm install
#   6. Start backend:  cd backend && uvicorn main:app --reload
#   7. Start frontend: cd frontend && npm run dev
#   8. Register a new account at http://localhost:3000
#
# NOTE: The database (trustshare.db) and encrypted file storage are
#       NOT committed to Git. Each system starts with a fresh database.
#       Share links from one system will NOT work on another.
# ============================================================

PROJECT_NAME="TrustShare - Secure File Sharing System"
ENVIRONMENT="development"
SECRET_KEY="your-super-secret-jwt-key-change-this"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Key Management Service (KMS) Configuration
# KMS_PROVIDER: "local" (development env var), "aws_kms", or "azure_keyvault"
KMS_PROVIDER="local"
MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# AWS_KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/example-id"
# AZURE_KEYVAULT_URL="https://your-vault.vault.azure.net/"

DATABASE_URL="sqlite:///./trustshare.db"
STORAGE_DIR="./storage_encrypted"
