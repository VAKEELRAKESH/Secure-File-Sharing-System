PROJECT_NAME="TrustShare - Secure File Sharing System"
ENVIRONMENT="development"
SECRET_KEY="your-super-secret-jwt-key-change-this"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Key Management Service (KMS) Configuration
# KMS_PROVIDER: "local" (development env var), "aws_kms", or "azure_keyvault"
KMS_PROVIDER="local"
MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# AWS_KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/example-id"
# AZURE_KEYVAULT_URL="https://your-vault.vault.azure.net/"

DATABASE_URL="sqlite:///./trustshare.db"
STORAGE_DIR="./storage_encrypted"

